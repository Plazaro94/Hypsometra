{
  "name": "hypsometra",
  "version": "0.1.0",
  "private": true,
  "description": "Mide el relieve de tu estrategia, no la altura de un pico.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @hypsometra/web",
    "build": "npm run build -w @hypsometra/engine && npm run build -ws --if-present",
    "test": "npm run test -w @hypsometra/engine",
    "test:engine": "npm run test -w @hypsometra/engine",
    "lint": "npm run lint -ws --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
